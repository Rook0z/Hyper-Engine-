# Hyperliquid API credentials
# Copy this file to .env and fill in your real values

HL_PRIVATE_KEY=your_private_key_here
HL_ACCOUNT_ADDRESS=your_wallet_address_here
HL_BASE_URL=https://api.hyperliquid-testnet.xyz

# Master safety switch for REAL Hyperliquid TESTNET order execution
# (src/execution/). Backtesting and paper trading NEVER place real
# orders, regardless of this setting. Leave this false unless you are
# deliberately running the testnet BUY->SELL smoke test
# (poetry run python -m execution.smoke_test) or live testnet
# execution. IS_MAINNET must also be false — mainnet is never used
# regardless of this flag.
ENABLE_TESTNET_LIVE_EXECUTION=false
